generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. TENANCY & IAM (Identity and Access Management)
// ==========================================

/// Entidade organizacional (B2B). Agrupa usuários e pedidos.
model Company {
  id            String   @id @default(uuid())
  cnpj          String   @unique
  corporateName String // Razão Social
  tradeName     String? // Nome Fantasia
  email         String?
  phone         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users  User[] // Relacionamento 1:N - Usuários vinculados à empresa
  orders Order[] // Relacionamento 1:N - Pedidos gerados pela empresa

  @@map("companies")
}

/// Usuários do sistema (Vendedores, Gestores, Clientes).
model User {
  id          String  @id @default(uuid())
  name        String
  email       String  @unique
  password    String
  phone       String?
  document    String? // Armazena CPF (PF) ou CNPJ (PJ)
  personType  String? @default("PF") // Identificador de natureza jurídica ("PF" ou "PJ")
  companyName String? @map("company") // Dado legado mantido para retrocompatibilidade

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  role            Role     @default(USER)
  isEmailVerified Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relacionamentos Inversos
  orders         Order[]
  ordersSeller   Order[]       @relation("OrderSeller")
  crmClients     CrmClient[]   @relation("SellerClients")
  crmDeals       CrmDeal[]     @relation("SellerDeals")
  crmActivities  CrmActivity[] @relation("SellerActivities")
  createdCoupons CrmCoupon[]   @relation("CouponCreator")
  crmNotes       CrmNote[]     @relation("NoteAuthor")

  @@index([companyId])
  @@map("users")
}

// ==========================================
// 2. INVENTORY & PRODUCT DOMAIN
// ==========================================

/// Representa os pontos físicos de exibição OOH (Painéis de LED, etc).
model Panel {
  id          String      @id @default(uuid())
  name        String
  description String?     @db.Text
  address     String?
  city        String?
  state       String?
  images      String[]
  categoryId  String?
  impacts     String // Tráfego estimado / Impressões
  lat         Float
  lng         Float
  px          String // Resolução em pixels
  size        String // Dimensões físicas (ex: "7x3")
  price       Float?
  status      PanelStatus @default(AVAILABLE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  category   Category?        @relation(fields: [categoryId], references: [id])
  analytics  AnalyticsEvent[]
  dealItems  CrmDealItem[]
  orderItems OrderItem[] // Relacionamento com os itens do pedido (Pacote)

  @@index([city, state])
  @@index([categoryId])
  @@map("panels")
}

model Institutional {
  id        String   @id @default("global") // Usamos um ID fixo para ter apenas um registro
  team      Json     @default("[]")
  brands    Json     @default("[]")
  updatedAt DateTime @updatedAt

  @@map("institutional")
}

/// Categorização do Inventário (Outdoor, Indoor, Totem, etc).
model Category {
  id          String  @id @default(uuid())
  name        String  @unique
  description String? @db.Text
  panels      Panel[]

  @@map("categories")
}

// ==========================================
// 3. SALES & OPERATIONS
// ==========================================

/// Transações fechadas e ordens de veiculação (Gestão Operacional / Pacotes).
model Order {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  sellerId String?
  seller   User?   @relation("OrderSeller", fields: [sellerId], references: [id])

  status     OrderStatus @default(PENDING)
  totalValue Float       @default(0)
  startDate  DateTime?
  endDate    DateTime?
  notes      String?     @db.Text
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  items OrderItem[] // Agora o pedido é um pacote contendo vários painéis

  @@index([userId])
  @@index([companyId])
  @@index([sellerId])
  @@map("orders")
}

/// Pontos (Painéis) vinculados a um pedido fechado (Pacote).
model OrderItem {
  id            String @id @default(uuid())
  orderId       String
  order         Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  panelId       String
  panel         Panel  @relation(fields: [panelId], references: [id])
  priceSnapshot Float  @default(0) // Valor do painel no momento do pedido

  @@index([orderId])
  @@index([panelId])
  @@map("order_items")
}

// ==========================================
// 4. CRM & PIPELINE DOMAIN
// ==========================================

/// Clientes captados/gerenciados no funil de vendas.
model CrmClient {
  id String @id @default(uuid())

  sellerId String
  seller   User   @relation("SellerClients", fields: [sellerId], references: [id])

  name      String
  document  String?
  email     String?
  phone     String?
  whatsapp  String?
  company   String?
  city      String?
  state     String?
  avatarUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deals      CrmDeal[]
  messages   CrmMessage[]
  activities CrmActivity[]
  notes      CrmNote[]
  coupons    CrmCoupon[]

  @@index([sellerId])
  @@map("crm_clients")
}

/// Oportunidades de negócio e orçamentos (Pipeline).
model CrmDeal {
  id String @id @default(uuid())

  clientId String
  client   CrmClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  sellerId String?
  seller   User?   @relation("SellerDeals", fields: [sellerId], references: [id])

  title          String
  expectedValue  Float      @default(0)
  contractMonths Int        @default(1)
  originalValue  Float      @default(0)
  probability    Int        @default(0)
  stage          DealStage  @default(NEW_LEAD)
  status         DealStatus @default(OPEN)
  expectedDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    CrmDealItem[]
  messages CrmMessage[]

  @@index([clientId])
  @@index([sellerId])
  @@map("crm_deals")
}

/// Pontos (Painéis) vinculados a uma oportunidade do CRM.
model CrmDealItem {
  id            String  @id @default(uuid())
  dealId        String
  deal          CrmDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  panelId       String
  panel         Panel   @relation(fields: [panelId], references: [id])
  priceSnapshot Float   @default(0) // Armazena o valor negociado no momento do orçamento

  @@index([dealId])
  @@index([panelId])
  @@map("crm_deal_items")
}

/// Histórico de comunicação vinculada a um lead/oportunidade.
model CrmMessage {
  id String @id @default(uuid())

  dealId String?
  deal   CrmDeal? @relation(fields: [dealId], references: [id], onDelete: Cascade)

  clientId String
  client   CrmClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  senderId   String // Pode armazenar ID do User (Vendedor) ou Client (Mensagem externa via WA)
  content    String?  @db.Text
  mediaUrl   String?
  mediaType  String?
  isRead     Boolean  @default(false)
  isInternal Boolean  @default(false) // Define se é nota interna invisível ao cliente
  createdAt  DateTime @default(now())

  @@index([dealId])
  @@index([clientId])
  @@map("crm_messages")
}

/// Tarefas e touchpoints (Reuniões, Ligações) executadas pelos vendedores.
model CrmActivity {
  id          String       @id @default(uuid())
  clientId    String
  client      CrmClient    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sellerId    String
  seller      User         @relation("SellerActivities", fields: [sellerId], references: [id])
  type        ActivityType
  title       String
  description String?      @db.Text
  dueDate     DateTime
  isCompleted Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([clientId])
  @@index([sellerId])
  @@map("crm_activities")
}

/// Anotações estruturadas sobre um cliente específico.
model CrmNote {
  id        String    @id @default(uuid())
  clientId  String
  client    CrmClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation("NoteAuthor", fields: [authorId], references: [id])
  content   String    @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([clientId])
  @@index([authorId])
  @@map("crm_notes")
}

/// Cupons promocionais focados na aquisição e conversão via CRM.
model CrmCoupon {
  id           String       @id @default(uuid())
  code         String       @unique
  creatorId    String
  creator      User         @relation("CouponCreator", fields: [creatorId], references: [id])
  discountType DiscountType
  value        Float
  minValue     Float?
  validUntil   DateTime?
  singleUse    Boolean      @default(false)
  isUsed       Boolean      @default(false)
  usedById     String?
  usedBy       CrmClient?   @relation(fields: [usedById], references: [id])
  usedAt       DateTime?
  createdAt    DateTime     @default(now())

  @@index([creatorId])
  @@index([usedById])
  @@map("crm_coupons")
}

// ==========================================
// 5. SYSTEM, METRICS & SETTINGS
// ==========================================

/// Agenda simplificada/global do sistema.
model AgendaTask {
  id        String   @id @default(uuid())
  title     String
  client    String // Nome do cliente armazenado de forma desnormalizada para buscas rápidas
  time      String // Formato 24h, Ex: "09:00"
  date      DateTime // Data do compromisso
  type      String // Categoria ("call", "meeting", "message", "task")
  status    String   @default("pending") // "pending" | "completed"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("agenda_tasks")
}

/// Banners promocionais/campanhas ativas no frontend público.
model Banner {
  id        String   @id @default(uuid())
  title     String?
  imageUrl  String
  linkUrl   String?
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banners")
}

/// Imagens de Portfólio da página T3 Solution
model SolutionPortfolio {
  id        String   @id @default(uuid())
  url       String
  alt       String
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("solution_portfolio")
}

/// Formulário de contato público do site.
model Contact {
  id        String        @id @default(uuid())
  name      String
  company   String?
  phone     String
  email     String
  message   String        @db.Text
  ip        String?
  userAgent String?
  origin    String?
  status    ContactStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("contacts")
}

/// Configurações paramétricas do sistema (Feature Toggles, Variáveis Dinâmicas).
model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  group     String
  updatedAt DateTime @updatedAt

  @@index([group])
  @@map("system_settings")
}

/// Registro de tráfego, cliques e acesso (Auditoria e Tracking de Mídia).
model AnalyticsEvent {
  id          String   @id @default(uuid())
  eventType   String
  path        String?
  panelId     String?
  panel       Panel?   @relation(fields: [panelId], references: [id])
  ip          String?
  os          String?
  browser     String?
  deviceModel String?
  country     String?
  city        String?
  referer     String?
  createdAt   DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([panelId])
  @@map("analytics_events")
}

// ==========================================
// 6. ENUMS (Domínios de Valor)
// ==========================================

enum Role {
  ADMIN
  MANAGER
  COMERCIAL
  USER
  COMPANY
}

enum PanelStatus {
  AVAILABLE
  MAINTENANCE
  RESERVED
  OCCUPIED
}

enum ContactStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
}

enum OrderStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum DealStage {
  NEW_LEAD
  FIRST_CONTACT
  NEGOTIATION
  WAITING_REPLY
  PROPOSAL_SENT
  POST_SALES
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum ActivityType {
  CALL
  MEETING
  MESSAGE
  FOLLOW_UP
  RENEWAL
}

enum DiscountType {
  PERCENTAGE
  FIXED_VALUE
}
