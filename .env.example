NODE_ENV=development
PORT=3333
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET=use-uma-chave-aleatoria-com-ao-menos-32-caracteres
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key-apenas-no-backend
SUPABASE_BUCKET=panels
# Origens extras liberadas no CORS (separadas por vírgula)
CORS_ORIGINS=
# Validação do reCAPTCHA (login e cadastro)
RECAPTCHA_SECRET_KEY=
# E-mail de recuperação de senha (Resend)
RESEND_API_KEY=
RESEND_FROM="T3 OOH <nao-responda@t3led.com.br>"

# Login com Google: ID do cliente OAuth (Google Cloud → APIs e serviços → Credenciais). Mesmo valor de VITE_GOOGLE_CLIENT_ID no frontend.
GOOGLE_CLIENT_ID=

# App desktop (T3 Gestor) e T3 Launcher: as versões ficam nas releases do repositório privado abaixo.
# O token precisa ENXERGAR esse repositório (fine-grained: acesso ao T3OOH/AppT3 com "Contents: Read-only").
# Sem acesso, o GitHub responde 404 e o app/launcher dizem que não há versão publicada.
GITHUB_TOKEN=
DESKTOP_REPOSITORY=T3OOH/AppT3
# Senha da área de download do launcher no site (conferida só aqui no servidor; não coloque no frontend)
LAUNCHER_DOWNLOAD_PASSWORD=
# Tag da release que guarda o zip do launcher (separada das versões do T3 Gestor)
LAUNCHER_RELEASE_TAG=launcher
